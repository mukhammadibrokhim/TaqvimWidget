<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>TaqvimWidget-Setup</AssemblyName>
    <RootNamespace>TaqvimWidget.Setup</RootNamespace>
    <AssemblyTitle>Taqvim Widget Setup</AssemblyTitle>
    <ApplicationIcon>..\..\assets\app.ico</ApplicationIcon>
    <ApplicationManifest>..\Shared\app.manifest</ApplicationManifest>
    <AppOutput>..\TaqvimWidget.App\bin\$(Configuration)\net48\</AppOutput>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Compile Include="..\Shared\*.cs" LinkBase="Shared" />
    <!-- Faqat yig'ish tartibi uchun: dastur fayllari quyida resurs sifatida joylanadi -->
    <ProjectReference Include="..\TaqvimWidget.App\TaqvimWidget.App.csproj" ReferenceOutputAssembly="false" />
    <EmbeddedResource Include="$(AppOutput)TaqvimWidget.exe" LogicalName="TaqvimWidget.exe" Visible="false" />
    <EmbeddedResource Include="$(AppOutput)TaqvimWidget.Core.dll" LogicalName="TaqvimWidget.Core.dll" Visible="false" />
  </ItemGroup>
</Project>
